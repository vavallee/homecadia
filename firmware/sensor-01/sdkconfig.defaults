# sensor-01: esp32c6, Matter over Thread, sleepy end device.
# Base: esp-matter v1.6 icd_app example defaults, adapted.
# ICD tuning happens against measured current (docs/power-budget.md).

CONFIG_IDF_TARGET="esp32c6"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# XIAO ESP32-C6 has no UART bridge (schematic sheet 3/5: USB D+/D- wired
# straight to the C6's native USB). Console must use USB Serial/JTAG or
# logs land on the unconnected UART0 pads (D6/D7).
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Light sleep powers down the USB Serial/JTAG peripheral, killing the USB
# port seconds after boot (host sees descriptor read errors). This option
# holds an ESP_PM_NO_LIGHT_SLEEP lock while USB is connected; on battery
# (no USB) the device sleeps normally, so it costs nothing in deployment.
CONFIG_USJ_NO_AUTO_LS_ON_CONNECTION=y

# BLE (commissioning transport)
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ENABLE_CONN_REATTEMPT=n

# Disable lwip ipv6 autoconfig
CONFIG_LWIP_IPV6_AUTOCONFIG=n

# Custom partition table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0xC000

# Wi-Fi off entirely: Thread-only device
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n
CONFIG_ENABLE_WIFI_AP=n
CONFIG_ENABLE_WIFI_STATION=n

# Enable HKDF in mbedtls
CONFIG_MBEDTLS_HKDF_C=y

# Endpoints: temperature, humidity (+ headroom for power source diagnostics)
CONFIG_ESP_MATTER_MAX_DYNAMIC_ENDPOINT_COUNT=4

# OpenThread, MTD (sleepy end device)
CONFIG_OPENTHREAD_ENABLED=y
CONFIG_OPENTHREAD_MTD=y
CONFIG_OPENTHREAD_SRP_CLIENT=y
CONFIG_OPENTHREAD_LOG_LEVEL_DYNAMIC=n
CONFIG_OPENTHREAD_LOG_LEVEL_NOTE=y
CONFIG_OPENTHREAD_CLI=n

# LwIP config for OpenThread
CONFIG_LWIP_IPV6_NUM_ADDRESSES=8
CONFIG_LWIP_MULTICAST_PING=y
CONFIG_LWIP_ND6=n
CONFIG_LWIP_IPV4=n
CONFIG_DISABLE_IPV4=y

# MDNS platform
CONFIG_USE_MINIMAL_MDNS=n

# Matter OTA requestor: on because the partition layout supports it; HA-side
# provider support is weak, so nothing in the app depends on it (see README).
CONFIG_ENABLE_OTA_REQUESTOR=y

# BLE modem sleep
CONFIG_BT_LE_SLEEP_ENABLE=y
CONFIG_BT_LE_LP_CLK_SRC_MAIN_XTAL=y
CONFIG_RTC_CLK_SRC_EXT_CRYS=n

# Power management: light sleep with DFS
CONFIG_PM_ENABLE=y
CONFIG_PM_DFS_INIT_AUTO=y
# Peripheral power-down in light sleep. EXPERIMENTAL in ESP-IDF v5.5.5 (default n,
# components/esp_pm/Kconfig); esp-matter examples/icd_app, which this file was copied
# from, enables it. Worth ~226 uA here: the quiet floor is 52 uA with it on against
# 282 uA with it off, because the TOP domain and HP peripherals stay powered otherwise.
# It was off between 2026-09-15 00:33 and 22:40 because the sensor stopped waking ~480 s
# after boot. Cause, bisected 2026-09-15: a light sleep landing inside the battery ADC
# sequence, which changes the sleep power-domain config as it creates and deletes the
# oneshot unit. battery.cpp now holds an ESP_PM_NO_LIGHT_SLEEP lock across that
# sequence; 20 min clean with the full poll. Needs the I2C/SPI allow_pd flags too, or
# the TOP domain never powers down at all. field-notes.md s21.
CONFIG_PM_POWER_DOWN_PERIPHERAL_IN_LIGHT_SLEEP=y
CONFIG_ESP_SLEEP_POWER_DOWN_FLASH=y
CONFIG_ESP_PHY_MAC_BB_PD=y
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y

# IEEE 802.15.4 radio sleep
CONFIG_IEEE802154_SLEEP_ENABLE=y

# mbedTLS
CONFIG_MBEDTLS_SSL_PROTO_DTLS=y

# Matter ICD server, SIT (short idle time) only. LIT was on until 2026-10-04 and
# bought nothing: it needs a controller that registers as a check-in client, and
# the Home Assistant matter server registers none (ICD RegisteredClients empty on
# node 28), so the device ran SIT anyway while paying for LIT twice:
#  - a LIT-capable ICD must keep ActiveModeThreshold >= 5000 ms (VerifyOrDie in
#    connectedhomeip ICDManager.cpp:80-82), so every report was followed by 5 s
#    of 500 ms fast polls: ~6.6 mC per 120 s, ~55 uA;
#  - a LIT-capable ICD in SIT mode idles for ICD_SHORT_IDLE_MODE_DURATION_SEC
#    (60 s) instead of the idle interval (ICDConfigurationData.cpp:112-121): one
#    extra wake per cycle, ~12 uA.
# Capture ppk2-20261004T190206, docs/power-budget.md.
CONFIG_ENABLE_ICD_SERVER=y
# CONFIG_ENABLE_ICD_LIT is not set
CONFIG_ICD_FAST_POLL_INTERVAL_MS=500
# Idle interval 120 -> 600 s. The device offers this as the subscription max
# interval (connectedhomeip ReadHandler.cpp:777-802), so a report with nothing
# to say goes out every 10 min instead of every 2. Changed values still report
# at once. The device's choice holds whatever max interval the controller asks
# for: the ceiling is at least kSubscriptionMaxIntervalPublisherLimit (60 min,
# ReadHandler.cpp:42-52), so only a controller min-interval floor above 600 s
# would change it. Cost: a dead unit takes
# ~10 min longer to show as unavailable.
CONFIG_ICD_IDLE_MODE_INTERVAL_SEC=600
CONFIG_ICD_ACTIVE_MODE_INTERVAL_MS=1000
# SDK default for a SIT ICD.
CONFIG_ICD_ACTIVE_MODE_THRESHOLD_MS=300
# Slow poll: 15 s is the SIT maximum (spec 9.16.1.5, ICDConfigurationData.h:267).
# 5 s -> 15 s measured 2026-09-17: settled cycle 240.6 -> 207.8 uA
# (docs/field-notes.md section 22). Cost: a controller command waits up to one
# interval.
CONFIG_ICD_SLOW_POLL_INTERVAL_MS=15000

# disable groupcast cluster until verified (upstream icd_app default)
CONFIG_SUPPORT_GROUPCAST_CLUSTER=n

# Device identity shown by controllers (vendor/product name, hardware version).
# Without this the device reports TEST_VENDOR / TEST_PRODUCT. IDs stay 0xFFF1/
# 0x8000 to match the test DAC — see main/chip_project_config.h.
CONFIG_CHIP_PROJECT_CONFIG="main/chip_project_config.h"

# GPIO light-sleep wake (encoder A on GPIO7, push switch on GPIO6). With this
# y, the sleep entry swaps a pin armed for HIGH to a pull-down
# (sleep_modes.c gpio_deep_sleep_wakeup_prepare), and the encoder re-arms A
# for whichever level it is not at. Our own pull-ups stay instead.
CONFIG_ESP_SLEEP_GPIO_ENABLE_INTERNAL_RESISTORS=n
